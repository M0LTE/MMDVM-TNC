# Fuzzing harness for MMDVM-TNC, using clang's libFuzzer.
#
#   make              build every fuzzer and generate the seed corpora
#   make run          run every fuzzer for TIME seconds each (default 60)
#   make run-kiss     fuzz one target: kiss, il2p_rx, il2p_tx, mode2_rx, ax25_rx
#   make clean
#
# Crashing inputs land in artifacts/<target>/. Each target's README-worthy
# details live at the top of its fuzz_<target>.cpp.
#
# The firmware sources are compiled exactly as the test harness compiles
# them -- unmodified, with the same shim standing in for the hardware -- but
# by clang, with ASan + UBSan and libFuzzer's coverage instrumentation.

FW  := ../..
OBJ := build

CLANG    ?= clang++
CXXFLAGS ?= -std=c++11 -g -O1
SANFLAGS := -fsanitize=address,undefined -fno-omit-frame-pointer
COVFLAGS := -fsanitize=fuzzer-no-link
WARNINGS := -Wall -Wextra -Wno-unused-parameter -Wno-reorder -Wno-unused-variable \
            -Wno-unused-but-set-variable -Wno-sign-compare -Wno-unused-private-field
INCLUDES := -I.. -I../shim -I$(FW)
DEFINES  := -DSTM32F4XX

TIME ?= 60

# Per-target input size caps: the sample-level receivers want room for a
# whole burst of 16 bit samples, the byte-level targets do not.
MAXLEN_kiss     := 8192
MAXLEN_il2p_rx  := 4096
MAXLEN_il2p_tx  := 2048
MAXLEN_mode2_rx := 131072
MAXLEN_ax25_rx  := 131072

TARGETS := kiss il2p_rx il2p_tx mode2_rx ax25_rx

FW_SRCS := Mode2RX.cpp Mode2TX.cpp \
           Mode3RX.cpp Mode3TX.cpp \
           IL2PRX.cpp IL2PTX.cpp IL2PRS.cpp \
           AX25RX.cpp AX25TX.cpp AX25Frame.cpp AX25CRC.cpp \
           AX25Demodulator.cpp AX25Twist.cpp \
           Hamming.cpp Utils.cpp TokenStore.cpp \
           IO.cpp SerialPort.cpp

FW_OBJS   := $(addprefix $(OBJ)/fw_,$(FW_SRCS:.cpp=.o)) $(OBJ)/fw_MMDVM.o
SHIM_OBJS := $(OBJ)/shim_Stubs.o $(OBJ)/shim_arm_math.o

FUZZERS := $(addprefix $(OBJ)/fuzz_,$(TARGETS))

COMPILE = $(CLANG) $(CXXFLAGS) $(SANFLAGS) $(COVFLAGS) -MMD -MP $(WARNINGS) $(INCLUDES) $(DEFINES)

.PHONY: all run clean $(addprefix run-,$(TARGETS))

all: $(FUZZERS) seeds

$(OBJ)/fw_MMDVM.o: $(FW)/MMDVM.cpp
	@mkdir -p $(OBJ)
	$(COMPILE) -Dmain=mmdvm_main_unused -c -o $@ $<

$(OBJ)/fw_%.o: $(FW)/%.cpp
	@mkdir -p $(OBJ)
	$(COMPILE) -c -o $@ $<

$(OBJ)/shim_%.o: ../shim/%.cpp
	@mkdir -p $(OBJ)
	$(COMPILE) -c -o $@ $<

$(OBJ)/%.o: %.cpp
	@mkdir -p $(OBJ)
	$(COMPILE) -c -o $@ $<

$(OBJ)/fuzz_%: $(OBJ)/fuzz_%.o $(FW_OBJS) $(SHIM_OBJS)
	$(CLANG) $(CXXFLAGS) -fsanitize=fuzzer,address,undefined -o $@ $^

# The seed corpora are generated by the firmware itself: real KISS frames,
# real IL2P encodings, real modulated bursts.
$(OBJ)/seedgen: $(OBJ)/seedgen.o $(FW_OBJS) $(SHIM_OBJS)
	$(CLANG) $(CXXFLAGS) $(SANFLAGS) -o $@ $^

.PHONY: seeds
seeds: $(OBJ)/seedgen
	@mkdir -p $(addprefix corpus/,$(TARGETS))
	./$(OBJ)/seedgen corpus

run: all
	@for t in $(TARGETS); do $(MAKE) --no-print-directory run-$$t TIME=$(TIME) || exit 1; done

$(addprefix run-,$(TARGETS)): run-%: $(OBJ)/fuzz_% seeds
	@mkdir -p artifacts/$*
	./$(OBJ)/fuzz_$* -max_total_time=$(TIME) -max_len=$(MAXLEN_$*) \
	                 -artifact_prefix=artifacts/$*/ -print_final_stats=1 corpus/$*

clean:
	@rm -rf $(OBJ) artifacts

-include $(OBJ)/*.d
